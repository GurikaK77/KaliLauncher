{
  "name": "rocket-launcher",
  "productName": "Rocket Launcher",
  "version": "1.0.0",
  "description": "დამოუკიდებელი Minecraft ლაუნჩერი: ნებისმიერი ვერსია, Fabric / Forge / NeoForge / OptiFine და საკუთარი მოდპაკები",
  "main": "main.js",
  "author": "Gurika Kartvelishvili",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always",
    "release:win": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ge.gurika.rocketlauncher",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "util.js",
      "game.js",
      "modpacks.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "modpack-files",
        "to": "modpack-files",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "REPLACE_WITH_YOUR_GITHUB_USERNAME",
      "repo": "REPLACE_WITH_YOUR_REPO_NAME"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
